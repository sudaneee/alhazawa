# Virtual environments — never belong in version control
env/
tenzin/

# Python bytecode
__pycache__/
*.pyc

# Collected static output (regenerated via collectstatic)
static/

# Stray artifact
]

# Real data — lives only on the server (and your local dev copy), never
# in git. Deploying via git pull/push must only ever touch code, not the
# live database or uploaded media.
db.sqlite3
media/
